# 改成实际的 OSS 桶和最小权限 RAM 用户凭证。
OSS_BUCKET_NAME=your-bucket-name
OSS_ACCESS_KEY_ID=your-access-key-id
OSS_ACCESS_KEY_SECRET=your-access-key-secret
# 默认自动使用 HTTPS；只有同地域 ECS 才使用 -internal 内网端点。
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 填域名或 IPv4 地址，不含 http://、端口或路径。
WEBDAV_SERVER_NAME=localhost
WEBDAV_USERNAME=webdav
# 密码用单引号包裹，保留其中的 $、# 和空格；请替换示例值。
WEBDAV_PASSWORD='replace-with-a-unique-strong-password'

# 首次本机测试可以关闭 SSL；远程使用请提供证书并改为 true。
SSL_ENABLED=false
# 需要其他设备访问时改为 0.0.0.0，并配置防火墙和 HTTPS。
BIND_ADDRESS=127.0.0.1
HTTP_PORT=9090
HTTPS_PORT=9043
OSS_MOUNT_TIMEOUT=30
TZ=Asia/Shanghai
